# ---------------------------------------------------------------
# Achu AI - environment variables
# Copy this file to ".env" for local testing.
# On a hosting service (Render, Railway, Cloud Run...), set these
# in the host's "Environment" settings instead. Never commit real keys.
# ---------------------------------------------------------------

# Google Gemini API key (get one from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Which AI provider to use: auto | gemini | openai
AI_PROVIDER=auto

# Optional: OpenAI fallback (only used if AI_PROVIDER is auto/openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Gemini model override
GEMINI_MODEL=gemini-3.5-flash
